{
    "update_url": "https://clients2.google.com/service/update2/crx",
    "manifest_version": 3,
    "name": "Multilektor",
    "version": "3.4.0",
    "description": "Polski lektor do filmów: czyta napisy na głos na YouTube, Netflixie i innych stronach, tłumaczy je i ścisza film na czas mowy.",
    "permissions": [
        "activeTab",
        "storage",
        "offscreen",
        "downloads",
        "scripting",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.iq.com/*",
        "*://*.iqiyi.com/*",
        "*://*.dailymotion.com/*",
        "*://dai.ly/*",
        "*://*.rumble.com/*",
        "*://*.huggingface.co/*",
        "*://*.hf.co/*",
        "*://*/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service-worker-loader.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "js": [
                "assets/auto_subs_hook.js"
            ],
            "matches": [
                "*://*.iq.com/*",
                "*://*.iqiyi.com/*",
                "*://*.viki.com/*",
                "*://*.wetv.vip/*",
                "*://*.bilibili.com/*",
                "*://*.bilibili.tv/*"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "js": [
                "src/content/netflix_seek_bridge.js"
            ],
            "matches": [
                "*://*.netflix.com/*"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "js": [
                "assets/cenzor_main.js",
                "assets/phrase_dict.js",
                "assets/yt_subs_bridge.js"
            ],
            "matches": [
                "*://*.youtube.com/*"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "js": [
                "assets/cenzor_main.js"
            ],
            "matches": [
                "*://*.netflix.com/*",
                "*://*.primevideo.com/*",
                "*://*.amazon.com/video/*",
                "*://*.iq.com/*",
                "*://*.iqiyi.com/*",
                "*://*.dailymotion.com/*",
                "*://dai.ly/*",
                "*://*.rumble.com/*",
                "*://*.viki.com/*",
                "*://*.wetv.vip/*",
                "*://*.bilibili.com/*",
                "*://*.bilibili.tv/*"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "js": [
                "assets/cenzor_bridge.js"
            ],
            "matches": [
                "*://*.youtube.com/*",
                "*://*.netflix.com/*",
                "*://*.primevideo.com/*",
                "*://*.amazon.com/video/*",
                "*://*.iq.com/*",
                "*://*.iqiyi.com/*",
                "*://*.dailymotion.com/*",
                "*://dai.ly/*",
                "*://*.rumble.com/*",
                "*://*.viki.com/*",
                "*://*.wetv.vip/*",
                "*://*.bilibili.com/*",
                "*://*.bilibili.tv/*"
            ],
            "run_at": "document_start"
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/options_hooks.js",
                "assets/lektor-controls.js",
                "assets/lektor-settings.js"
            ],
            "matches": [
                "*://*.netflix.com/*",
                "*://*.youtube.com/*",
                "*://*.primevideo.com/*",
                "*://*.amazon.com/video/*",
                "*://*.iq.com/*",
                "*://*.iqiyi.com/*",
                "*://*.dailymotion.com/*",
                "*://dai.ly/*",
                "*://*.rumble.com/*",
                "*://*.viki.com/*",
                "*://*.wetv.vip/*",
                "*://*.bilibili.com/*",
                "*://*.bilibili.tv/*"
            ],
            "run_at": "document_idle"
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/lektor_bar.js",
                "assets/content.js-BgeP3Ise.js"
            ],
            "matches": [
                "*://*.netflix.com/*"
            ],
            "run_at": "document_idle"
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/lektor_bar.js",
                "assets/sub_panel.js",
                "assets/youtube_content.js-CI940SBo.js"
            ],
            "matches": [
                "*://*.youtube.com/*"
            ],
            "run_at": "document_idle",
            "all_frames": true
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/lektor_bar.js",
                "assets/dom_content.js",
                "assets/auto_subs.js"
            ],
            "matches": [
                "*://*.primevideo.com/*",
                "*://*.amazon.com/video/*",
                "*://*.iq.com/*",
                "*://*.iqiyi.com/*"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/lektor_bar.js",
                "assets/dom_content.js"
            ],
            "matches": [
                "*://*.dailymotion.com/*",
                "*://dai.ly/*",
                "*://*.rumble.com/*"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "js": [
                "assets/i18n_en.js",
                "assets/i18n.js",
                "assets/lektor_bar.js",
                "assets/dom_content.js",
                "assets/auto_subs.js"
            ],
            "matches": [
                "*://*.viki.com/*",
                "*://*.wetv.vip/*",
                "*://*.bilibili.com/*",
                "*://*.bilibili.tv/*"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "js": [
                "assets/dyktowanie_bridge.js"
            ],
            "matches": [
                "http://127.0.0.1/app*"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "src/options/options.html",
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "Multilektor — ustawienia",
        "default_icon": {
            "16": "icon-16.png",
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "web_accessible_resources": [
        {
            "matches": [
                "*://*.netflix.com/*"
            ],
            "resources": [
                "src/content/inject.js",
                "src/content/netflix_seek_bridge.js",
                "sherpa/*",
                "assets/content.js-BgeP3Ise.js"
            ],
            "use_dynamic_url": false
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "resources": [
                "assets/youtube_content.js-CI940SBo.js"
            ],
            "use_dynamic_url": false
        }
    ],
    "cross_origin_embedder_policy": {
        "value": "require-corp"
    },
    "cross_origin_opener_policy": {
        "value": "same-origin"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}
